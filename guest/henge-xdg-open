#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""
henge-xdg-open: Arch Linux guest URL opener and dual-stack OAuth callback relay.

1. Detects localhost/loopback redirect_uri ports (127.0.0.1 or [::1]) in OAuth URLs.
2. Exposes the port via PUT http://10.0.2.4/.henge/expose-port and bridges
   10.0.2.15:<PORT> <-> 127.0.0.1:<PORT> / [::1]:<PORT>.
3. Opens the URL in native iOS SFSafariViewController via PUT http://10.0.2.4/.henge/open-url
   (supporting Face ID, Passkeys, and existing Safari sessions).
4. Dismisses the Safari sheet via PUT http://10.0.2.4/.henge/oauth-done once the
   loopback callback returns HTTP 200 or 302.
"""

import errno
import os
import re
import socket
import sys
import threading
import time
import urllib.parse
import urllib.request

GATEWAY = "http://10.0.2.4/.henge"
DEFAULT_GUEST_NIC_IP = "10.0.2.15"
OAUTH_FINAL_RE = re.compile(
    rb"^HTTP/(?:1\.[01]|2(?:\.0)?)\s+(?:200|201|202|204)\b",
    re.IGNORECASE,
)
OAUTH_REDIRECT_RE = re.compile(
    rb"^HTTP/(?:1\.[01]|2(?:\.0)?)\s+(?:301|302|303|307|308)\b",
    re.IGNORECASE,
)
LOCATION_HEADER_RE = re.compile(rb"^Location:\s*([^\r\n]+)", re.IGNORECASE | re.MULTILINE)
LOOPBACK_HOST_RE = re.compile(r"^https?://(?:localhost|127(?:\.\d{1,3}){3}|\[::1\])(?::\d+)?(?:/|$)", re.IGNORECASE)
OAUTH_QUERY_KEYS = (
    "redirect_uri",
    "redirect_url",
    "callback",
    "return_to",
    "next",
    "continue",
    "post_logout_redirect_uri",
)


def resolve_guest_nic_ip() -> str:
    probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        probe.connect(("10.0.2.4", 80))
        ip = probe.getsockname()[0]
        if ip and not ip.startswith("127."):
            return ip
    except OSError:
        pass
    finally:
        probe.close()
    return DEFAULT_GUEST_NIC_IP


def gateway_put(endpoint: str, payload: str = "", log_errors: bool = False) -> None:
    req = urllib.request.Request(
        f"{GATEWAY}/{endpoint}",
        data=payload.encode("utf-8"),
        method="PUT",
    )
    try:
        with urllib.request.urlopen(req, timeout=3):
            pass
    except Exception as exc:
        if log_errors:
            print(f"henge-xdg-open: gateway PUT /{endpoint} failed: {exc}", file=sys.stderr)


def is_allowed_http_url(target_url: str) -> bool:
    try:
        parsed = urllib.parse.urlparse(target_url)
    except ValueError:
        return False
    return parsed.scheme.lower() in ("http", "https") and bool(parsed.hostname)


def is_loopback_hostname(host: str | None) -> bool:
    if not host:
        return False
    h = host.strip("[]").lower()
    if h in ("localhost", "::1", "::ffff:127.0.0.1"):
        return True
    parts = h.split(".")
    if len(parts) == 4 and all(p.isdigit() and 0 <= int(p) <= 255 for p in parts):
        return int(parts[0]) == 127
    return False


def _match_loopback_port_in_text(raw_val: str) -> int | None:
    decoded = urllib.parse.unquote(raw_val)
    match = re.search(
        r"https?://(?:localhost|127(?:\.\d{1,3}){3}|\[::1\]):(\d{1,5})",
        decoded,
        re.IGNORECASE,
    )
    if match:
        port = int(match.group(1))
        if 1 <= port <= 65535:
            return port
    return None


def extract_loopback_port(target_url: str) -> int | None:
    parsed = urllib.parse.urlparse(target_url)
    if is_loopback_hostname(parsed.hostname) and parsed.port is not None:
        port = int(parsed.port)
        return port if 1 <= port <= 65535 else None

    params = urllib.parse.parse_qs(parsed.query)
    for key in OAUTH_QUERY_KEYS:
        for val in params.get(key, []):
            port = _match_loopback_port_in_text(val)
            if port is not None:
                return port

    for values in params.values():
        for val in values:
            port = _match_loopback_port_in_text(val)
            if port is not None:
                return port
    return None


def connect_loopback(port: int, wait_seconds: float = 3.0) -> socket.socket:
    deadline = time.monotonic() + wait_seconds
    while True:
        for family, host in ((socket.AF_INET, "127.0.0.1"), (socket.AF_INET6, "::1")):
            sock = socket.socket(family, socket.SOCK_STREAM)
            try:
                sock.settimeout(1.0)
                sock.connect((host, port))
                sock.settimeout(None)
                return sock
            except OSError:
                sock.close()
        if time.monotonic() >= deadline:
            break
        time.sleep(0.1)
    raise ConnectionRefusedError(f"No loopback listener on port {port}")


def _response_completes_oauth(header_bytes: bytes) -> bool:
    if OAUTH_FINAL_RE.match(header_bytes):
        return True
    if OAUTH_REDIRECT_RE.match(header_bytes):
        loc_match = LOCATION_HEADER_RE.search(header_bytes)
        if loc_match:
            loc = loc_match.group(1).decode("latin-1", errors="ignore").strip()
            if loc.startswith("/") or LOOPBACK_HOST_RE.match(loc):
                return False
        return True
    return False


def relay_stream(
    src: socket.socket,
    dst: socket.socket,
    done_event: threading.Event,
    is_response: bool = False,
) -> None:
    header_buf = bytearray()
    header_checked = False
    try:
        while True:
            chunk = src.recv(4096)
            if not chunk:
                break
            if is_response and not header_checked:
                header_buf.extend(chunk[:512])
                if b"\r\n\r\n" in header_buf or b"\n\n" in header_buf or len(header_buf) >= 512:
                    header_checked = True
                    if _response_completes_oauth(bytes(header_buf)):
                        done_event.set()
            dst.sendall(chunk)
    except OSError:
        pass
    finally:
        if is_response and not header_checked and header_buf:
            if _response_completes_oauth(bytes(header_buf)):
                done_event.set()
        try:
            dst.shutdown(socket.SHUT_WR)
        except OSError:
            pass


def handle_relay_client(client: socket.socket, port: int, done_event: threading.Event) -> None:
    upstream: socket.socket | None = None
    try:
        client.settimeout(30.0)
        upstream = connect_loopback(port)
        upstream.settimeout(30.0)
        t1 = threading.Thread(
            target=relay_stream,
            args=(client, upstream, done_event, False),
            daemon=True,
        )
        t2 = threading.Thread(
            target=relay_stream,
            args=(upstream, client, done_event, True),
            daemon=True,
        )
        t1.start()
        t2.start()
        t1.join(timeout=30.0)
        t2.join(timeout=30.0)
    except OSError:
        pass
    finally:
        try:
            client.close()
        except OSError:
            pass
        if upstream is not None:
            try:
                upstream.close()
            except OSError:
                pass


def is_port_listening(port: int) -> bool:
    """Passively inspect /proc/net/tcp and /proc/net/tcp6 for TCP_LISTEN (0A) without sending SYNs."""
    target_hex = f":{port:04X}"
    for proc_path in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            with open(proc_path, "r", encoding="utf-8") as fh:
                next(fh, None)
                for line in fh:
                    cols = line.split()
                    if len(cols) >= 4 and cols[3].upper() == "0A" and cols[1].upper().endswith(target_hex):
                        return True
        except OSError:
            continue
    return False


def wait_for_port_listener(port: int, timeout: float = 3.0) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if is_port_listening(port):
            return True
        time.sleep(0.1)
    return is_port_listening(port)


def daemonize_background() -> None:
    """Double-fork and detach stdio so CLI callers (gh, gcloud, xdg-open) return 0 immediately."""
    pid = os.fork()
    if pid > 0:
        os._exit(0)
    os.setsid()
    pid2 = os.fork()
    if pid2 > 0:
        os._exit(0)

    devnull = os.open(os.devnull, os.O_RDWR)
    try:
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
    finally:
        if devnull > 2:
            os.close(devnull)


def run_oauth_bridge(port: int, url: str) -> None:
    bind_ip = resolve_guest_nic_ip()
    listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listener.settimeout(0.5)
    try:
        try:
            listener.bind((bind_ip, port))
        except OSError as bind_exc:
            if bind_exc.errno == errno.EADDRNOTAVAIL and bind_ip != "0.0.0.0":
                listener.bind(("0.0.0.0", port))
            else:
                raise
        listener.listen(8)
    except OSError as exc:
        listener.close()
        if exc.errno == errno.EADDRINUSE:
            # Guest listener already bound 0.0.0.0/[::] on this port; expose via libslirp
            # and wait in background until the one-shot OAuth listener closes to dismiss Safari.
            gateway_put("expose-port", str(port), log_errors=True)
            gateway_put("open-url", url, log_errors=True)
            daemonize_background()
            wait_for_port_listener(port, timeout=3.0)
            deadline = time.monotonic() + 180.0
            while time.monotonic() < deadline and is_port_listening(port):
                time.sleep(0.4)
            gateway_put("oauth-done", str(port))
            return
        gateway_put("open-url", url, log_errors=True)
        return

    gateway_put("expose-port", str(port), log_errors=True)
    gateway_put("open-url", url, log_errors=True)

    # Return control to parent CLI caller immediately while relaying callback in background.
    daemonize_background()

    done_event = threading.Event()
    workers: list[threading.Thread] = []
    overall_deadline = time.monotonic() + 180.0
    grace_deadline: float | None = None
    try:
        while time.monotonic() < overall_deadline:
            if done_event.is_set():
                if grace_deadline is None:
                    grace_deadline = time.monotonic() + 1.5
                elif time.monotonic() >= grace_deadline:
                    break
            try:
                client, _ = listener.accept()
            except TimeoutError:
                continue
            worker = threading.Thread(
                target=handle_relay_client,
                args=(client, port, done_event),
                daemon=True,
            )
            worker.start()
            workers.append(worker)
        for worker in workers:
            worker.join(timeout=2.0)
    finally:
        listener.close()
        if done_event.is_set():
            gateway_put("oauth-done", str(port))


def main() -> int:
    if len(sys.argv) < 2 or not sys.argv[1]:
        print("usage: henge-xdg-open <url>", file=sys.stderr)
        return 2

    target = sys.argv[1]
    if not is_allowed_http_url(target):
        if os.environ.get("HENGE_XDG_FALLBACK") == "1":
            print(f"henge-xdg-open: blocked recursive xdg-open fallback for URI: {target}", file=sys.stderr)
            return 1
        if os.path.isfile("/usr/bin/xdg-open") and os.access("/usr/bin/xdg-open", os.X_OK):
            os.environ["HENGE_XDG_FALLBACK"] = "1"
            browser_env = os.environ.get("BROWSER", "")
            if "henge-xdg-open" in browser_env:
                filtered = [p for p in browser_env.split(":") if "henge-xdg-open" not in p]
                if filtered:
                    os.environ["BROWSER"] = ":".join(filtered)
                else:
                    os.environ.pop("BROWSER", None)
            os.execv("/usr/bin/xdg-open", ["/usr/bin/xdg-open", *sys.argv[1:]])
        print(f"henge-xdg-open: ignoring unsupported non-HTTP(S) URI: {target}", file=sys.stderr)
        return 1

    port = extract_loopback_port(target)
    if port is not None:
        run_oauth_bridge(port, target)
    else:
        gateway_put("open-url", target, log_errors=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
