#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""
henge-xdg-open: Arch Linux guest URL opener and dual-stack OAuth callback relay.

1. Detects localhost/loopback redirect_uri ports (127.0.0.1 or [::1]) in OAuth URLs.
2. Exposes the port via PUT http://10.0.2.4/.henge/expose-port and bridges
   10.0.2.15:<PORT> <-> 127.0.0.1:<PORT> / [::1]:<PORT>.
3. Opens the URL in native iOS SFSafariViewController via PUT http://10.0.2.4/.henge/open-url
   (supporting Face ID, Passkeys, and existing Safari sessions).
4. Dismisses the Safari sheet via PUT http://10.0.2.4/.henge/oauth-done once the
   loopback callback returns HTTP 200 or 302.
"""

import errno
import os
import re
import socket
import sys
import threading
import time
import urllib.parse
import urllib.request

GATEWAY = "http://10.0.2.4/.henge"
GUEST_NIC_IP = "10.0.2.15"
OAUTH_DONE_PREFIXES = (
    b"HTTP/1.0 200",
    b"HTTP/1.1 200",
    b"HTTP/1.0 201",
    b"HTTP/1.1 201",
    b"HTTP/1.0 204",
    b"HTTP/1.1 204",
    b"HTTP/1.0 301",
    b"HTTP/1.1 301",
    b"HTTP/1.0 302",
    b"HTTP/1.1 302",
    b"HTTP/1.0 303",
    b"HTTP/1.1 303",
    b"HTTP/1.0 307",
    b"HTTP/1.1 307",
    b"HTTP/1.0 308",
    b"HTTP/1.1 308",
)


def gateway_put(endpoint: str, payload: str = "") -> None:
    req = urllib.request.Request(
        f"{GATEWAY}/{endpoint}",
        data=payload.encode("utf-8"),
        method="PUT",
    )
    try:
        with urllib.request.urlopen(req, timeout=3):
            pass
    except Exception:
        pass


def extract_loopback_port(target_url: str) -> int | None:
    parsed = urllib.parse.urlparse(target_url)
    if parsed.hostname in ("localhost", "127.0.0.1", "::1") and parsed.port is not None:
        return int(parsed.port)

    params = urllib.parse.parse_qs(parsed.query)
    for key in ("redirect_uri", "redirect_url", "callback", "state"):
        for val in params.get(key, []):
            match = re.search(
                r"https?://(?:localhost|127\.0\.0\.1|\[::1\]):(\d{2,5})",
                urllib.parse.unquote(val),
            )
            if match:
                return int(match.group(1))
    return None


def connect_loopback(port: int) -> socket.socket:
    for family, host in ((socket.AF_INET, "127.0.0.1"), (socket.AF_INET6, "::1")):
        sock = socket.socket(family, socket.SOCK_STREAM)
        try:
            sock.settimeout(2.0)
            sock.connect((host, port))
            sock.settimeout(None)
            return sock
        except OSError:
            sock.close()
    raise ConnectionRefusedError(f"No loopback listener on port {port}")


def relay_stream(
    src: socket.socket,
    dst: socket.socket,
    done_event: threading.Event,
    is_response: bool = False,
) -> None:
    first_chunk = True
    try:
        while True:
            chunk = src.recv(4096)
            if not chunk:
                break
            if is_response and first_chunk and chunk.startswith(OAUTH_DONE_PREFIXES):
                done_event.set()
            first_chunk = False
            dst.sendall(chunk)
    except OSError:
        pass
    finally:
        try:
            dst.shutdown(socket.SHUT_WR)
        except OSError:
            pass


def daemonize_background() -> None:
    """Double-fork and detach stdio so CLI callers (gh, gcloud, xdg-open) return 0 immediately."""
    pid = os.fork()
    if pid > 0:
        os._exit(0)
    os.setsid()
    pid2 = os.fork()
    if pid2 > 0:
        os._exit(0)

    devnull = os.open(os.devnull, os.O_RDWR)
    try:
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
    finally:
        if devnull > 2:
            os.close(devnull)


def run_oauth_bridge(port: int, url: str) -> None:
    listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listener.settimeout(180.0)
    try:
        listener.bind((GUEST_NIC_IP, port))
        listener.listen(4)
    except OSError as exc:
        listener.close()
        if exc.errno == errno.EADDRINUSE:
            # Guest listener already bound 0.0.0.0/[::] on this port; expose via libslirp.
            gateway_put("expose-port", str(port))
        gateway_put("open-url", url)
        return

    gateway_put("expose-port", str(port))
    gateway_put("open-url", url)

    # Return control to parent CLI caller immediately while relaying callback in background.
    daemonize_background()

    done_event = threading.Event()
    try:
        while not done_event.is_set():
            try:
                client, _ = listener.accept()
            except TimeoutError:
                break
            try:
                upstream = connect_loopback(port)
            except OSError:
                client.close()
                continue
            t1 = threading.Thread(
                target=relay_stream,
                args=(client, upstream, done_event, False),
                daemon=True,
            )
            t2 = threading.Thread(
                target=relay_stream,
                args=(upstream, client, done_event, True),
                daemon=True,
            )
            t1.start()
            t2.start()
            t1.join(timeout=5.0)
            t2.join(timeout=5.0)
            client.close()
            upstream.close()
    finally:
        listener.close()
        if done_event.is_set():
            time.sleep(0.3)
            gateway_put("oauth-done", str(port))


def main() -> int:
    if len(sys.argv) < 2 or not sys.argv[1]:
        print("usage: henge-xdg-open <url>", file=sys.stderr)
        return 2

    target = sys.argv[1]
    port = extract_loopback_port(target)
    if port is not None:
        run_oauth_bridge(port, target)
    else:
        gateway_put("open-url", target)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
